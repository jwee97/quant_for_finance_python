# Copy this file to `.env` (git ignores `.env`) and fill in the values, or set them as environment variables.
# On Replit use Tools > Secrets instead: do not put a real key in this file, in `.replit` or in any file that is committed.

# iTick API key (https://itick.org). Needed only to download prices from iTick.
ITICK_API_KEY=

# Optional iTick settings (the defaults suit the free plan):
# ITICK_CALLS_PER_MINUTE=5        # raise it only if your plan allows more calls a minute
# ITICK_BASE_URL=https://api-free.itick.org
# ITICK_DAILY_KTYPE=8             # iTick's interval code for daily bars
# ITICK_PAGE_SIZE=1000            # daily bars asked for per call
# ITICK_MAX_PAGES=12              # most calls spent on one ticker's history
# ITICK_MAX_CALLS_PER_RUN=60      # a download needing more calls than this is refused up front

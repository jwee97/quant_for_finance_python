# Copy this file to `.env` (git ignores `.env`) and fill in the values, or set them as environment variables.
# On Replit use Tools > Secrets instead: do not put a real key in this file, in `.replit` or in any file that is committed.

# iTick API key (https://itick.org). Needed only to download prices from iTick.
ITICK_API_KEY=

# Optional iTick settings (the defaults suit the free plan):
# ITICK_CALLS_PER_MINUTE=5        # raise it only if your plan allows more calls a minute
# ITICK_BASE_URL=https://api-free.itick.org
# ITICK_DAILY_KTYPE=8             # iTick's interval code for daily bars
# ITICK_PAGE_SIZE=1000            # daily bars asked for per call
# ITICK_MAX_PAGES=12              # most calls spent on one ticker's history
# ITICK_MAX_CALLS_PER_RUN=60      # a download needing more calls than this is refused up front

# Finzdata API key (https://finzdata.com/docs; the free plan asks only for an email address). Needed only to download futures from Finzdata in the Futures tab.
FINZDATA_API_KEY=

# Optional Finzdata settings:
# FINZDATA_DAILY_CALLS=900        # most calls the app sends in a UTC day (the free plan allows 1,000)
# FINZDATA_URL=https://api.finzdata.com

# A code the dashboard asks for before it serves anything. Required if the app can be reached by anyone but you (docker compose with QUANT_LAB_BIND=0.0.0.0, a VPS, a Replit deployment); see docs/deployment.md.
QUANT_LAB_ACCESS_CODE=
# docker compose only: the address the dashboard's port is published on. 127.0.0.1 (this machine only) is the default; 0.0.0.0 reaches it from other machines, and needs the access code above.
# QUANT_LAB_BIND=127.0.0.1

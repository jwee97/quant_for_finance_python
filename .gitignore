# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Derived data. Raw data IS committed (see data/README.md) because it is the
# immutable record the research is built on; everything downstream is
# reproducible from it via `python -m experiments.run_all`.
data/processed/*
# CFTC zips are large and the current-year one changes weekly; the parsed positioning table and the manifest
# (with every zip's sha256) are committed instead.
data/raw/altdata/cftc/*.zip
data/features/*
!data/**/.gitkeep

# Local overrides
config/local.yaml
.env

# Stage caches and logs (rebuilt by the pipeline)
reports/logs/

# A user's own experiment runs accumulate locally (Generation 5)
data/experiments.db
data/experiments/
reports/tearsheets/
site/

# Tickers downloaded by the dashboard (cached for a day) and nothing else under data/user
data/user/

# Coverage data
.coverage
coverage.xml
